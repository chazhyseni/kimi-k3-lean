# .gitattributes
# Line endings are normalised to LF in the repository. Without this, a clone on Windows
# with core.autocrlf=true checks the shell scripts out with CRLF and every one of them
# fails under bash with `bad interpreter: /bin/bash^M`.
* text=auto eol=lf

# Executable text that must be LF on every platform, including a Windows checkout.
*.sh    text eol=lf
*.py    text eol=lf

# Binary: never transform, and do not attempt a textual diff.
*.png   binary
*.pdf   binary
*.bin   binary
*.safetensors binary
*.model binary
