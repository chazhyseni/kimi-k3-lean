#!/usr/bin/env bash
# kimi-k3-lean — CLI launcher for running a Kimi K3 OpenAI server.
#
# This script is downloaded into ~/.local/bin by the installer and is
# the only entry point most users need. It wraps the repo's serve/
# entry-point script with sensible defaults so users don't have to
# figure out PATH, PYTHONPATH, or which library file to point at.
#
# Usage:
#   kimi-k3-lean serve --model /path/to/k3 [--port 8080] [--api-key ...]
#   kimi-k3-lean status
#   kimi-k3-lean stop
#   kimi-k3-lean models / list
#   kimi-k3-lean chat --model kimi-k3 --message "hello"
#   kimi-k3-lean install   # no-op if already installed; prints help
#   kimi-k3-lean doctor    # prints what's installed, what's missing
#   kimi-k3-lean uninstall # stops server, removes the launcher itself
#
# Env (set once, persist via kimi-k3-lean config):
#   K3_HOME         repo checkout (~/.kimi-k3-lean)
#   K3_MODEL        default model dir (overridable per command)
#   K3_PORT         default 8080
#   K3_HOST         default 127.0.0.1
#   K3_API_KEY      bearer token; one auto-generated and stored if missing
#   K3_MODEL_NAME   advertised id (default kimi-k3)

set -euo pipefail

# Cross-platform Python detection (python3 on POSIX, python on Windows).
if command -v python3 >/dev/null 2>&1; then
    K3_PY=python3
elif command -v python >/dev/null 2>&1; then
    K3_PY=python
else
    echo "kimi-k3-lean: python3 / python not found; install Python 3.11+" >&2
    exit 1
fi

# ----- finding the repo -----
_k3_find_repo() {
    # 1. explicit K3_HOME wins
    if [ -n "${K3_HOME:-}" ] && [ -f "$K3_HOME/serve/__main__.py" ]; then
        echo "$K3_HOME"
        return 0
    fi
    # 2. THIS script sits in the repo root (dev install: ./kimi-k3-lean serve)
    local me="${BASH_SOURCE[0]}"
    while [ -L "$me" ]; do me=$(readlink "$me"); done
    local script_dir
    script_dir=$(cd "$(dirname "$me")" && pwd)
    if [ -f "$script_dir/serve/__main__.py" ]; then
        echo "$script_dir"
        return 0
    fi
    # 3. the launcher next to the clone at ~/.kimi-k3-lean/kimi-k3-lean
    if [ -f "$HOME/.kimi-k3-lean/serve/__main__.py" ]; then
        echo "$HOME/.kimi-k3-lean"
        return 0
    fi
    # 4. install layout where the launcher lives at <prefix>/bin/kimi-k3-lean
    #    and the clone sits at <prefix>/repo
    local prefix
    prefix=$(dirname "$(dirname "$me")")
    if [ -f "$prefix/repo/serve/__main__.py" ]; then
        echo "$prefix/repo"
        return 0
    fi
    # 5. XDG-style fallback
    if [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/kimi-k3-lean/serve/__main__.py" ]; then
        echo "${XDG_DATA_HOME:-$HOME/.local/share}/kimi-k3-lean"
        return 0
    fi
    return 1
}

if ! K3_HOME_RESOLVED=$(_k3_find_repo); then
    cat >&2 <<'EOF'
kimi-k3-lean: no repo found.

This launcher expects the kimi-k3-lean repo at one of:
  $K3_HOME                 (env var)
  <script dir>/../repo
  ~/.kimi-k3-lean
  $XDG_DATA_HOME/kimi-k3-lean

Install with:
  curl -fsSL https://raw.githubusercontent.com/chazhyseni/kimi-k3-lean/main/install.sh | bash
EOF
    exit 1
fi
export K3_HOME="$K3_HOME_RESOLVED"

K3_CONF="$K3_HOME/server.env"
# precedence: shell env > conf file > built-in defaults
# Load the file only for vars the user did NOT set on the command line.
[ -f "$K3_CONF" ] || true  # exists check is harmless
__env_set() { [ -n "${!1:-}" ]; }
__load_if_unset() {
    # NOTE: do NOT use `set -e` semantics in here. `[ -n "" ]` returns 1,
    # which would abort the script. Use guard-style tests instead.
    local var="$1" def="$2"
    local cur="${!var:-}"
    local from_file=""
    if [ -z "$cur" ] && [ -f "$K3_CONF" ]; then
        from_file=$(grep -E "^${var}=" "$K3_CONF" 2>/dev/null | head -1 | cut -d= -f2- || true)
    fi
    if [ -n "$from_file" ]; then
        printf -v "$var" '%s' "$from_file"
        export "$var"
    elif [ -z "$cur" ]; then
        printf -v "$var" '%s' "$def"
        export "$var"
    fi
}
__load_if_unset K3_PORT 8080
__load_if_unset K3_HOST 127.0.0.1
__load_if_unset K3_API_KEY ""
__load_if_unset K3_MODEL_DIR ""
__load_if_unset K3_MODEL_NAME kimi-k3
# K3_MODEL is just an alias for K3_MODEL_DIR; if neither is set, neither
# can we serve anything.
: "${K3_MODEL:=$K3_MODEL_DIR}"

# ----- subcommands -----
cmd="${1:-help}"
shift 2>/dev/null || true

_k3_status() {
    local pid=""
    if [ -f "$K3_HOME/server.pid" ]; then
        pid=$(cat "$K3_HOME/server.pid" 2>/dev/null || true)
    fi
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "kimi-k3-lean running: PID $pid  http://$K3_HOST:$K3_PORT  $K3_HOME/server.log"
        return 0
    fi
    echo "kimi-k3-lean: no server running on http://$K3_HOST:$K3_PORT"
    return 1
}

_k3_stop() {
    if [ -f "$K3_HOME/server.pid" ]; then
        local pid
        pid=$(cat "$K3_HOME/server.pid" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "killing PID $pid"
            kill "$pid" 2>/dev/null || true
            for i in 1 2 3 4 5; do
                kill -0 "$pid" 2>/dev/null || break
                sleep 0.2
            done
        fi
        rm -f "$K3_HOME/server.pid"
    fi
    # Also free the port if anything else is bound. Cross-platform:
    #   Linux: ss -ltnp + kill (or lsof)
    #   macOS: lsof -ti tcp:PORT | xargs kill
    #   Windows (git-bash): netstat -ano + taskkill
    _k3_kill_port() {
        local port="$1"
        if command -v ss >/dev/null 2>&1; then
            # Linux + modern macOS
            local pids
            pids=$(ss -ltnp "sport = :$port" 2>/dev/null \
                | grep -oP 'pid=\K[0-9]+' | sort -u || true)
            [ -n "$pids" ] && kill $pids 2>/dev/null || true
        elif command -v lsof >/dev/null 2>&1; then
            # macOS / BSDs
            local pids
            pids=$(lsof -ti "tcp:$port" 2>/dev/null || true)
            [ -n "$pids" ] && kill $pids 2>/dev/null || true
        elif command -v fuser >/dev/null 2>&1; then
            # Older Linux distros
            fuser -k "${port}/tcp" 2>/dev/null || true
        elif command -v netstat >/dev/null 2>&1 && command -v taskkill >/dev/null 2>&1; then
            # Windows (git-bash has netstat via /c/Windows; taskkill for the kill)
            local pid
            pid=$(netstat -ano 2>/dev/null | grep ":$port " | awk '{print $NF}' | head -1)
            [ -n "$pid" ] && taskkill //F //PID "$pid" 2>/dev/null || true
        fi
    }
    _k3_kill_port "$K3_PORT"
    echo "stopped."
}

_k3_serve() {
    if [ ! -d "$K3_MODEL" ]; then
        cat >&2 <<EOF
No model directory found at: $K3_MODEL

To download the real Kimi K3 weights (~982 GB, ~4 hours):
  kimi-k3-lean fetch
or
  $K3_HOME/scripts/setup-and-serve.sh --download-only

Until then the server will start, return 200 on /v1/models, and
return a documented engine_error envelope from /v1/chat/completions.
That lets you test the HTTP scaffold end-to-end immediately.
EOF
        mkdir -p "$K3_MODEL"
    fi
    _k3_stop  # idempotent
    # Cross-platform random hex: /dev/urandom on POSIX, CryptoAPI on
    # Windows. Fall back to time-based if neither available.
    if [ -r /dev/urandom ]; then
        : "${K3_API_KEY:=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')}"
    elif command -v openssl >/dev/null 2>&1; then
        : "${K3_API_KEY:=$(openssl rand -hex 16 2>/dev/null || echo "k3-$$")}"
    else
        : "${K3_API_KEY:=k3-$(date +%s)-$$}"
    fi

    # write the env so future shells / uninstall know the token
    cat > "$K3_CONF" <<EOF
K3_HOME=$K3_HOME
K3_HOST=$K3_HOST
K3_PORT=$K3_PORT
K3_API_KEY=$K3_API_KEY
K3_MODEL=$K3_MODEL
K3_MODEL_NAME=$K3_MODEL_NAME
EOF
    chmod 600 "$K3_CONF"

    cd "$K3_HOME"
    # Ensure libk3.so is on LD_LIBRARY_PATH even if the user moved the launcher.
    # On Windows this is a no-op (libk3.dll is loaded via PATH on Windows).
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*|CYGWIN*) : ;;  # Windows: rely on PATH for .dll discovery
        *) export LD_LIBRARY_PATH="$K3_HOME/bin:${LD_LIBRARY_PATH:-}" ;;
    esac
    "$K3_PY" -u serve/__main__.py "$K3_MODEL" \
        --host "$K3_HOST" --port "$K3_PORT" \
        --api-key "$K3_API_KEY" --model-id "$K3_MODEL_NAME" \
        "$@" \
        >>"$K3_HOME/server.log" 2>&1 </dev/null &
    local pid=$!
    echo "$pid" > "$K3_HOME/server.pid"
    echo "started: PID $pid  http://$K3_HOST:$K3_PORT"
    echo "log:     $K3_HOME/server.log"
    echo "token:   $K3_API_KEY  (in $K3_CONF, mode 0600)"
    # wait for /v1/models to return 200 (or 30s)
    local ready=0
    for i in $(seq 1 30); do
        local code
        code=$(curl -sS --max-time 1 -o /dev/null -w '%{http_code}' \
            -H "Authorization: Bearer $K3_API_KEY" \
            "http://$K3_HOST:$K3_PORT/v1/models" 2>/dev/null || echo 000)
        if [ "$code" = "200" ]; then ready=1; break; fi
        sleep 1
    done
    if [ "$ready" = "1" ]; then
        echo "ready."
    else
        echo "not ready after 30s; check $K3_HOME/server.log"
        return 1
    fi
}

_k3_models() {
    if ! _k3_status >/dev/null 2>&1; then
        echo "no server running. start with: kimi-k3-lean serve"
        return 1
    fi
    : "${K3_API_KEY:?no token; run 'kimi-k3-lean config set api_key ...' first}"
    curl -sS -H "Authorization: Bearer $K3_API_KEY" "http://$K3_HOST:$K3_PORT/v1/models"
}

_k3_chat() {
    if ! _k3_status >/dev/null 2>&1; then
        echo "no server running. start with: kimi-k3-lean serve &"
        return 1
    fi
    local model="" message="" stream=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --model)  model="$2"; shift 2 ;;
            --message|-m) message="$2"; shift 2 ;;
            --stream) stream=1; shift ;;
            *) message="$1"; shift ;;
        esac
    done
    : "${model:=$K3_MODEL_NAME}"
    : "${message:?no --message given}"
    : "${K3_API_KEY:?no token}"
    local payload
    payload=$("$K3_PY" -c "
import json,sys
print(json.dumps({'model':sys.argv[1],'messages':[{'role':'user','content':sys.argv[2]}],'max_tokens':256,'stream': bool(int(sys.argv[3]))}))
" "$model" "$message" "$stream")
    if [ "$stream" = "1" ]; then
        curl -sSN -X POST -H "Content-Type: application/json" \
            -H "Authorization: Bearer $K3_API_KEY" \
            "http://$K3_HOST:$K3_PORT/v1/chat/completions" \
            -d "$payload"
    else
        curl -sS -X POST -H "Content-Type: application/json" \
            -H "Authorization: Bearer $K3_API_KEY" \
            "http://$K3_HOST:$K3_PORT/v1/chat/completions" \
            -d "$payload"
    fi
}

_k3_fetch() {
    exec "$K3_HOME/scripts/setup-and-serve.sh" --download-only
}

_k3_doctor() {
    echo "== kimi-k3-lean doctor =="
    echo "repo:       $K3_HOME"
    # file(1) doesn't exist on Windows; fall back to byte-count + magic check.
    if [ -f "$K3_HOME/bin/libk3.so" ] || [ -f "$K3_HOME/bin/libk3.dylib" ] || [ -f "$K3_HOME/bin/libk3.dll" ]; then
        local lib
        for lib in libk3.so libk3.dylib libk3.dll; do
            if [ -f "$K3_HOME/bin/$lib" ]; then
                echo "engine:     $K3_HOME/bin/$lib ($(wc -c < "$K3_HOME/bin/$lib" 2>/dev/null) bytes)"
                break
            fi
        done
    else
        echo "engine:     MISSING (build via make or bootstrap.sh)"
    fi
    echo "model dir:  ${K3_MODEL:-NOT SET}"
    if [ -n "$K3_MODEL" ] && [ -d "$K3_MODEL" ]; then
        echo "  contains: $(ls "$K3_MODEL" | head -3 | tr '\n' ' ')"
        echo "            $(ls "$K3_MODEL" | wc -l) files total"
    fi
    echo "port:       $K3_PORT"
    echo "host:       $K3_HOST"
    echo "token set:  $([ -n "${K3_API_KEY:-}" ] && echo yes || echo NO)"
    _k3_status || true
    echo "python:     $(python3 --version 2>&1)"
    echo "hermes:     $(command -v hermes || echo NOT INSTALLED)"
    if command -v hermes >/dev/null; then
        echo "  providers.ollama-launch.models includes '$K3_MODEL_NAME': $(hermes config get providers.ollama-launch.models 2>/dev/null | grep -c -- "$K3_MODEL_NAME") times"
    fi
}

_k3_config() {
    # very small wrapper: kimi-k3-lean config [get NAME | set NAME VALUE | unset NAME]
    local op="${1:-show}"; shift 2>/dev/null || true
    case "$op" in
        show)   echo "K3_HOME=$K3_HOME"; cat "$K3_CONF" 2>/dev/null || true ;;
        get)    grep -E "^${1}=" "$K3_CONF" 2>/dev/null | head -1 | cut -d= -f2- ;;
        set)    local k="$1" v="$2"
                grep -v "^${k}=" "$K3_CONF" 2>/dev/null > "$K3_CONF.tmp" || true
                echo "${k}=${v}" >> "$K3_CONF.tmp"
                mv "$K3_CONF.tmp" "$K3_CONF"
                chmod 600 "$K3_CONF" ;;
        unset)  sed -i.bak "/^${1}=/d" "$K3_CONF" 2>/dev/null || true ; rm -f "$K3_CONF.bak" ;;
    esac
}

_k3_uninstall() {
    _k3_stop
    cat >&2 <<EOF
This uninstalls ONLY the launcher and the server+token. The repo at
$K3_HOME and any downloaded model weights are kept (delete with rm -rf).
EOF
    rm -f "$K3_BIN"  # symlink this script lives at
    if command -v hermes >/dev/null; then
        hermes config unset model.base_url model.api_key model.default 2>/dev/null || true
        hermes config set providers.ollama-launch.models "$(hermes config get providers.ollama-launch.models 2>/dev/null | grep -v -- "$K3_MODEL_NAME" | "$K3_PY" -c 'import re,sys; print(repr([l.strip()[2:] for l in sys.stdin if l.strip().startswith("- ")])))')" 2>/dev/null || true
    fi
    echo "uninstalled. to fully remove the repo:  rm -rf $K3_HOME"
}

_k3_stack() {
    # subcommand: stack <up|down|status|logs> [FLAGS]
    local sub="${1:-status}"; shift 2>/dev/null || true
    local repo="$K3_HOME"
    local deploy_dir="$repo/deploy"
    if [ ! -d "$deploy_dir" ]; then
        echo "no deploy/ directory at $deploy_dir"
        return 1
    fi
    if ! command -v docker >/dev/null 2>&1; then
        echo "docker not installed; install Docker Desktop or Docker Engine first"
        return 1
    fi
    if ! docker compose version >/dev/null 2>&1; then
        echo "docker compose plugin missing; install compose v2 (apt: docker-compose-plugin)"
        return 1
    fi
    local compose=(docker compose -f "$deploy_dir/compose.yml")
    case "$sub" in
        up)
            local profiles=()
            # parse flags: --webui, --lan (sets tls=internal), --public (no tls=internal)
            while [ $# -gt 0 ]; do
                case "$1" in
                    --webui)   profiles+=(--profile with-webui); shift ;;
                    --k3)      profiles+=(--profile with-k3); shift ;;
                    --lan)     profiles+=(--profile lan); shift ;;
                    *) echo "unknown flag: $1"; return 2 ;;
                esac
            done
            # create .env from example if missing
            if [ ! -f "$deploy_dir/.env" ] && [ -f "$deploy_dir/.env.example" ]; then
                cp "$deploy_dir/.env.example" "$deploy_dir/.env"
                echo "created $deploy_dir/.env from example (edit before production!)"
            fi
            "${compose[@]}" "${profiles[@]}" up -d --build "$@"
            echo ""
            echo "stack up. Try:"
            echo "  kimi-k3-lean stack status"
            echo "  curl http://localhost/v1/models -H \"Authorization: Bearer \$(grep ^INTERNAL_API_KEY= $deploy_dir/.env | cut -d= -f2)\""
            echo "  open http://localhost/  (only with --webui)"
            ;;
        down)  "${compose[@]}" down "$@" ;;
        status) "${compose[@]}" ps ;;
        logs)  "${compose[@]}" logs -f "$@" ;;
        *) echo "unknown stack sub: $sub (try up/down/status/logs)"; return 2 ;;
    esac
}

_k3_install() {
    # If this launcher is in ~/.local/bin, the install is complete.
    # Otherwise it was run from the repo; tell the user how to install.
    local bin_path="${BASH_SOURCE[0]}"
    if [ "$bin_path" = "$HOME/.local/bin/kimi-k3-lean" ] || [ "$bin_path" = "$HOME/.local/bin/$(basename "$bin_path")" ]; then
        echo "Already installed at $bin_path. Nothing to do."
    else
        cat <<EOF
Not yet on PATH. To install the launcher system-wide:

  mkdir -p ~/.local/bin
  cp $bin_path ~/.local/bin/kimi-k3-lean
  export PATH="\$HOME/.local/bin:\$PATH"

Or use the bootstrap installer:

  curl -fsSL https://raw.githubusercontent.com/chazhyseni/kimi-k3-lean/main/bootstrap.sh | bash
EOF
    fi
}

_k3_help() {
    sed -n '2,40p' "$0" | sed 's/^# \{0,1\}//'
    echo ""
    echo "Subcommands:"
    echo "  serve [FLAGS]      start the server (flags go to serve/__main__.py)"
    echo "  status             print running PID + URL"
    echo "  stop               stop the running server"
    echo "  models | list      curl /v1/models"
    echo "  chat -m 'msg'      one-shot /v1/chat/completions"
    echo "  fetch              download K3 weights (delegates to setup-and-serve.sh)"
    echo "  doctor             print install state"
    echo "  config get|set|unset NAME [VALUE]"
    echo "  stack up [--webui] docker compose up the full stack (Caddy+gateway+router+model+Open WebUI)"
    echo "  stack down         docker compose down"
    echo "  stack status       docker compose ps"
    echo "  stack logs [SVC]   tail compose logs"
    echo "  install            print install hints"
    echo "  uninstall          stop server, remove launcher"
    echo "  help               this"
}

case "$cmd" in
    serve)    _k3_serve "$@" ;;
    stop)     _k3_stop ;;
    status)   _k3_status ;;
    models|list) _k3_models ;;
    chat)     _k3_chat "$@" ;;
    fetch)    _k3_fetch ;;
    doctor)   _k3_doctor ;;
    config)   _k3_config "$@" ;;
    stack)    _k3_stack "$@" ;;
    install)  _k3_install ;;
    uninstall) _k3_uninstall ;;
    help|--help|-h) _k3_help ;;
    *)        echo "unknown subcommand: $cmd"; _k3_help; exit 2 ;;
esac
