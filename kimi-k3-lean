#!/usr/bin/env bash
# kimi-k3-lean — CLI launcher.
#
#   kimi-k3-lean start              start the OpenAI server
#   kimi-k3-lean stop               stop it
#   kimi-k3-lean status             show running PID + URL
#   kimi-k3-lean chat -m "hello"    one-shot chat (alias: ask)
#   kimi-k3-lean models             curl /v1/models
#   kimi-k3-lean fetch              download K3 weights (~982 GB, resumable)
#   kimi-k3-lean doctor             print install state
#   kimi-k3-lean stack up [--webui]  LAN stack (Caddy + gateway + Open WebUI)
#   kimi-k3-lean stack down
#   kimi-k3-lean uninstall          stop server, remove launcher
#   kimi-k3-lean help

set -euo pipefail

# --- find python ---
if command -v python3 >/dev/null 2>&1; then K3_PY=python3
elif command -v python >/dev/null 2>&1; then K3_PY=python
else echo "python not found" >&2; exit 1; fi

ok()   { printf '\033[1;32m  ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m  !\033[0m %s\n' "$*" >&2; }
say()  { printf '\033[1;36m==>\033[0m %s\n' "$*" >&2; }

# --- find repo ---
_k3_find_repo() {
    [ -n "${K3_HOME:-}" ] && [ -f "$K3_HOME/serve/__main__.py" ] && { echo "$K3_HOME"; return 0; }
    [ -f "$HOME/.kimi-k3-lean/serve/__main__.py" ] && { echo "$HOME/.kimi-k3-lean"; return 0; }
    local me="${BASH_SOURCE[0]}"
    while [ -L "$me" ]; do me=$(readlink "$me"); done
    local d; d=$(cd "$(dirname "$me")" && pwd)
    [ -f "$d/serve/__main__.py" ] && { echo "$d"; return 0; }
    return 1
}

K3_HOME=$(_k3_find_repo 2>/dev/null || echo "")
if [ -z "$K3_HOME" ]; then
    echo "kimi-k3-lean: repo not found. Install with:" >&2
    echo "  curl -fsSL https://raw.githubusercontent.com/chazhyseni/kimi-k3-lean/main/bootstrap.sh | bash" >&2
    exit 1
fi
export K3_HOME

# --- load config ---
K3_CONF="${K3_CONF:-$K3_HOME/server.env}"
_k3_load() {
    local var="$1" def="$2" cur="${!1:-}" val=""
    if [ -z "$cur" ] && [ -f "$K3_CONF" ]; then
        val=$(grep -E "^${var}=" "$K3_CONF" 2>/dev/null | head -1 | cut -d= -f2- || true)
    fi
    : "${!var:=${val:-$def}}"
    export "$var"
}
_k3_load K3_PORT 8080
_k3_load K3_HOST 127.0.0.1
_k3_load K3_API_KEY ""
_k3_load K3_MODEL_DIR "$K3_HOME/checkpoints/k3"
_k3_load K3_MODEL_NAME kimi-k3
: "${K3_MODEL:=$K3_MODEL_DIR}"

# --- subcommands ---
cmd="${1:-help}"; shift 2>/dev/null || true

_k3_status() {
    local pid=""
    [ -f "$K3_HOME/server.pid" ] && pid=$(cat "$K3_HOME/server.pid" 2>/dev/null || echo "")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        echo "running: PID $pid  http://$K3_HOST:$K3_PORT"
        return 0
    fi
    # try to discover by port
    local found=""
    if command -v lsof >/dev/null 2>&1; then
        found=$(lsof -ti tcp:"$K3_PORT" -sTCP:LISTEN 2>/dev/null | head -1)
    elif command -v ss >/dev/null 2>&1; then
        found=$(ss -ltnp 2>/dev/null | grep ":$K3_PORT " | grep -oP 'pid=\K[0-9]+' | head -1)
    fi
    if [ -n "$found" ] && kill -0 "$found" 2>/dev/null; then
        echo "$found" > "$K3_HOME/server.pid" 2>/dev/null || true
        echo "running (discovered): PID $found  http://$K3_HOST:$K3_PORT"
        return 0
    fi
    echo "no server running on http://$K3_HOST:$K3_PORT"
    return 1
}

_k3_stop() {
    if [ -f "$K3_HOME/server.pid" ]; then
        local pid; pid=$(cat "$K3_HOME/server.pid" 2>/dev/null || echo "")
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            for i in 1 2 3 4 5; do kill -0 "$pid" 2>/dev/null || break; sleep 0.2; done
        fi
        rm -f "$K3_HOME/server.pid"
    fi
    # free port
    if command -v fuser >/dev/null 2>&1; then
        fuser -k "${K3_PORT}/tcp" 2>/dev/null || true
    elif command -v lsof >/dev/null 2>&1; then
        lsof -ti tcp:"$K3_PORT" 2>/dev/null | xargs kill 2>/dev/null || true
    fi
    echo "stopped"
}

_k3_serve() {
    _k3_stop  # idempotent
    [ -d "$K3_MODEL" ] || mkdir -p "$K3_MODEL"
    # generate token if none
    if [ -z "$K3_API_KEY" ]; then
        K3_API_KEY=$(head -c16 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n' || openssl rand -hex 16 2>/dev/null || echo "k3-$$")
        export K3_API_KEY
    fi
    # write env
    cat > "$K3_CONF" <<EOF
K3_HOME=$K3_HOME
K3_HOST=$K3_HOST
K3_PORT=$K3_PORT
K3_API_KEY=$K3_API_KEY
K3_MODEL=$K3_MODEL
K3_MODEL_NAME=$K3_MODEL_NAME
EOF
    chmod 600 "$K3_CONF"

    cd "$K3_HOME"
    export LD_LIBRARY_PATH="$K3_HOME/bin:${LD_LIBRARY_PATH:-}"
    "$K3_PY" -u serve/__main__.py "$K3_MODEL" \
        --host "$K3_HOST" --port "$K3_PORT" \
        --api-key "$K3_API_KEY" --model-id "$K3_MODEL_NAME" \
        "$@" >>"$K3_HOME/server.log" 2>&1 </dev/null &
    local pid=$!
    echo "$pid" > "$K3_HOME/server.pid"
    echo "started: PID $pid  http://$K3_HOST:$K3_PORT"
    echo "log:     $K3_HOME/server.log"
    # wait for ready
    for i in $(seq 1 30); do
        local code
        code=$(curl -sS --max-time 1 -o /dev/null -w '%{http_code}' \
            -H "Authorization: Bearer $K3_API_KEY" \
            "http://$K3_HOST:$K3_PORT/v1/models" 2>/dev/null || echo 000)
        [ "$code" = "200" ] && { echo "ready"; return 0; }
        sleep 1
    done
    echo "not ready after 30s; check $K3_HOME/server.log"
    return 1
}

_k3_chat() {
    _k3_status >/dev/null 2>&1 || { echo "no server running"; return 1; }
    local model="$K3_MODEL_NAME" message="" stream=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --model)  model="$2"; shift 2 ;;
            -m|--message) message="$2"; shift 2 ;;
            --stream) stream=1; shift ;;
            *) message="$1"; shift ;;
        esac
    done
    : "${message:?no message given (-m \"...\")}"
    : "${K3_API_KEY:?no token in $K3_CONF}"
    local payload
    payload=$("$K3_PY" -c "
import json,sys
print(json.dumps({'model':sys.argv[1],'messages':[{'role':'user','content':sys.argv[2]}],'max_tokens':256,'stream':bool(int(sys.argv[3]))}))
" "$model" "$message" "$stream")
    if [ "$stream" = "1" ]; then
        curl -sSN -X POST -H "Content-Type: application/json" \
            -H "Authorization: Bearer $K3_API_KEY" \
            "http://$K3_HOST:$K3_PORT/v1/chat/completions" -d "$payload"
    else
        curl -sS -X POST -H "Content-Type: application/json" \
            -H "Authorization: Bearer $K3_API_KEY" \
            "http://$K3_HOST:$K3_PORT/v1/chat/completions" -d "$payload"
    fi
}

_k3_models() {
    _k3_status >/dev/null 2>&1 || { echo "no server running"; return 1; }
    curl -sS -H "Authorization: Bearer $K3_API_KEY" "http://$K3_HOST:$K3_PORT/v1/models"
}

_k3_fetch() {
    local model_dir="${K3_MODEL:-$K3_HOME/checkpoints/k3}"
    export K3_DIR="$K3_HOME" K3_MODEL_DIR="$model_dir"
    exec "$K3_HOME/scripts/download-model.sh" "$model_dir"
}

_k3_doctor() {
    echo "== kimi-k3-lean doctor =="
    echo "repo:       $K3_HOME"
    for lib in libk3.so libk3.dylib libk3.dll; do
        if [ -f "$K3_HOME/bin/$lib" ]; then
            echo "engine:     bin/$lib ($(wc -c < "$K3_HOME/bin/$lib" 2>/dev/null) bytes)"
            break
        fi
    done
    echo "model dir:  $K3_MODEL"
    if [ -d "$K3_MODEL" ]; then
        echo "  files:    $(find "$K3_MODEL" -name '*.safetensors' 2>/dev/null | wc -l) safetensors"
    fi
    echo "port:       $K3_PORT"
    echo "token set:  $([ -n "$K3_API_KEY" ] && echo yes || echo NO)"
    _k3_status || true
    echo "python:     $($K3_PY --version 2>&1)"
}

_k3_stack() {
    local sub="${1:-status}"; shift 2>/dev/null || true
    local d="$K3_HOME/deploy"
    [ -d "$d" ] || { echo "no deploy/ at $d"; return 1; }
    command -v docker >/dev/null 2>&1 || { echo "docker not installed"; return 1; }
    local compose=(docker compose -f "$d/compose.yml")
    case "$sub" in
        up)
            local profiles=()
            while [ $# -gt 0 ]; do
                case "$1" in
                    --webui) profiles+=(--profile with-webui); shift ;;
                    --k3)    profiles+=(--profile with-k3); shift ;;
                    *)       shift ;;
                esac
            done
            [ -f "$d/.env" ] || cp "$d/.env.example" "$d/.env" 2>/dev/null || true
            "${compose[@]}" "${profiles[@]}" up -d --build
            echo "stack up. status: kimi-k3-lean stack status"
            ;;
        down)   "${compose[@]}" down "$@" ;;
        status)  "${compose[@]}" ps ;;
        logs)    "${compose[@]}" logs -f "$@" ;;
        *)       echo "usage: stack <up [--webui] [--k3] | down | status | logs>"; return 2 ;;
    esac
}

_k3_uninstall() {
    _k3_stop
    rm -f "$HOME/.local/bin/kimi-k3-lean"
    if command -v hermes >/dev/null 2>&1; then
        hermes config unset model.base_url model.api_key model.default 2>/dev/null || true
    fi
    echo "uninstalled. repo at $K3_HOME kept (rm -rf to wipe)"
}

_k3_help() {
    cat <<EOF
kimi-k3-lean — local Kimi K3 OpenAI server

  start              start the server on http://$K3_HOST:$K3_PORT
  stop               stop the server
  status             show running PID + URL
  chat -m "msg"      one-shot chat (alias: ask)
  models             curl /v1/models
  fetch              download K3 weights (~982 GB, resumable)
  doctor             print install state
  stack up [--webui] LAN stack with Caddy + Open WebUI
  stack down         stop LAN stack
  uninstall          stop server, remove launcher
  help               this

Env (via $K3_CONF or shell):
  K3_HOST, K3_PORT, K3_API_KEY, K3_MODEL_DIR, K3_MODEL_NAME
EOF
}

case "$cmd" in
    start|serve) _k3_serve "$@" ;;
    stop)         _k3_stop ;;
    status)       _k3_status ;;
    chat|ask)     _k3_chat "$@" ;;
    models|list)  _k3_models ;;
    fetch)        _k3_fetch "$@" ;;
    doctor)       _k3_doctor ;;
    stack)        _k3_stack "$@" ;;
    uninstall)    _k3_uninstall ;;
    help|--help|-h) _k3_help ;;
    *)            echo "unknown: $cmd (try: help)"; exit 2 ;;
esac