# .dockerignore — files NOT copied into the Docker build context.
# This list is intentionally exhaustive; a missing line here means the
# build context is larger than it needs to be.

# Build artifacts (regenerated inside the container).
build/
x86_64-*/
aarch64-*/
arm64-*/
*.o
*.a
*.so
*.so.*
*.dylib
*.dll

# Git.
.git/
.gitattributes

# Tests and fixtures (we run them inside the container; we don't need
# the source tree to ship them in).
tests/fixtures/cache/
tests/fixtures/st/

# Editor / OS metadata.
.vscode/
.idea/
.cursor/
.aider*
.DS_Store

# Logs.
*.log
logs/

# Model weights (NEVER ship these; mount at runtime).
*.safetensors
*.gguf
*.bin
*.pth
*.pt
models/

# Python cache.
__pycache__/
*.py[cod]
.venv/
venv/

# Documentation that doesn't need to be in the image.
docs/_build/

# The article's huge README (3400 lines, 146 KB).
# We keep README.md in the image for `docker inspect` and `docker run --help`.
# But we exclude everything else.

# Secrets / creds.
.env
*.pem
*_key
*_key.pub
hf_token*

# CI / coverage.
.github/
.coverage
htmlcov/