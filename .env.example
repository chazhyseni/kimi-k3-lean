# .env.example — copy to .env and edit.
#
# Required: where is your converted Kimi K3 checkpoint?
LITMOE_MODEL_DIR=/path/to/checkpoint

# Engine preset: laptop | desktop | workstation | server | max
LITMOE_PRESET=server

# Server port on the host. Container always listens on 8080 internally;
# this maps host:8080 → container:8080.
LITMOE_PORT=8080

# Optional: API key for the OpenAI server. If unset, the server is open
# and listens on 127.0.0.1 only — DO NOT expose to the network.
# Generate one with: openssl rand -hex 32
# LITMOE_API_KEY=

# Optional: thread count. The article's reference uses 8 cores; raise
# to use more if your machine has them.
# LITMOE_THREADS=8