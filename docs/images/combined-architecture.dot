// combined-architecture.dot — kimi-k3-lean engine + OpenAI server seam.
//
// Render with:
//   dot -Tpng docs/images/combined-architecture.dot \
//       -o docs/images/combined-architecture.png
//
// LAYOUT (top to bottom):
//   ROW 0 — title
//   ROW 1 — DESIGN PRINCIPLES (4 numbered choices)
//   ROW 2 — REQUEST FLOW: any harness -> OpenAI HTTP server -> libk3.so
//   ROW 3 — ENGINE FORWARD: tokenizer -> embed -> MoE stack -> lm_head -> argmax -> detok
//   ROW 4 — STATE / CACHE: KDA recurrent state, MLA KV cache, LRU expert cache, trunk cache
//   ROW 5 — MEMORY BOUNDARY banner (RAM above, NVMe below)
//   ROW 6 — DISK: trunk (108.81 GB), expert pool (1.45 TB MXFP4), embed/lm_head
//   ROW 7 — OFFLINE PREP: fetch -> convert
//   ROW 8 — legend
//
// All numeric claims here are sourced from the engine's own headers
// (include/k3/k3.h) and the article's docs/PERFORMANCE.md. Anything
// measured on a different host is labelled as such.

digraph combined_architecture {
    graph [
        rankdir=TB,
        splines=ortho,
        nodesep=0.18,
        ranksep=0.42,
        bgcolor="white",
        fontname="Helvetica",
        label=<<TABLE BORDER="0" CELLBORDER="0"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="22"><B>kimi-k3-lean — combined engine architecture</B></FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="13" COLOR="#666666">Kimi K3 (2.78T) inference exposed as an OpenAI Chat Completions HTTP server</FONT></TD></TR><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10" COLOR="#999999">measured on AMD EPYC 7763 (article); host-independent</FONT></TD></TR></TABLE>>,
        labelloc=t,
        pad=0.4,
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname="Helvetica",
        fontsize=11,
        margin=0.12,
    ];

    edge [color="#888888", penwidth=1.2, arrowsize=0.8];

    // ============================================================
    // ROW 1 — DESIGN PRINCIPLES
    // ============================================================
    {
        rank=same;
        p1 [label=<<FONT POINT-SIZE="20" COLOR="#2e8b3d"><B>①</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#2e8b3d"><B>disk-resident</B></FONT><BR/><FONT POINT-SIZE="9">1.45 TB MXFP4 experts</FONT><BR/><FONT POINT-SIZE="9">streamed from NVMe</FONT>>, fillcolor="#e8f5e8"];
        p2 [label=<<FONT POINT-SIZE="20" COLOR="#2e8b3d"><B>②</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#2e8b3d"><B>MXFP4 native</B></FONT><BR/><FONT POINT-SIZE="9">OCP MX FP4, group 32</FONT><BR/><FONT POINT-SIZE="9">no dequant-on-read</FONT>>, fillcolor="#e8f5e8"];
        p3 [label=<<FONT POINT-SIZE="20" COLOR="#2e8b3d"><B>③</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#2e8b3d"><B>trunk-as-a-dial</B></FONT><BR/><FONT POINT-SIZE="9">108.81 GB streamable</FONT><BR/><FONT POINT-SIZE="9">layers pin/unpin on demand</FONT>>, fillcolor="#e8f5e8"];
        p4 [label=<<FONT POINT-SIZE="20" COLOR="#2e8b3d"><B>④</B></FONT><BR/><FONT POINT-SIZE="11" COLOR="#2e8b3d"><B>LRU expert cache</B></FONT><BR/><FONT POINT-SIZE="9">hot experts stay in RAM</FONT><BR/><FONT POINT-SIZE="9">cold experts stream</FONT>>, fillcolor="#e8f5e8"];
        p1 -> p2 -> p3 -> p4 [style=invis];
    }

    // ============================================================
    // ROW 2 — REQUEST FLOW (harness -> server -> engine)
    // ============================================================
    {
        rank=same;
        harness [label=<<FONT POINT-SIZE="11"><B>any OpenAI-compat harness</B></FONT><BR/><FONT POINT-SIZE="9">Hermes, Open WebUI, LM Studio,</FONT><BR/><FONT POINT-SIZE="9">Claude Code, aider, Pi, OpenCode,</FONT><BR/><FONT POINT-SIZE="9">the openai Python client, raw curl</FONT>>, fillcolor="#fffbe8", shape=box3d];
        server  [label=<<FONT POINT-SIZE="11" COLOR="#5d3fd3"><B>serve/server.py</B></FONT><BR/><FONT POINT-SIZE="9">stdlib http.server + ThreadingHTTPServer</FONT><BR/><FONT POINT-SIZE="9">SSE streaming, bearer auth, 16 MB cap</FONT><BR/><FONT POINT-SIZE="9">OpenAI error envelope, conversation resume</FONT>>, fillcolor="#e8e0f5"];
        libk3   [label=<<FONT POINT-SIZE="11" COLOR="#5d3fd3"><B>libk3.so  (162 KB)</B></FONT><BR/><FONT POINT-SIZE="9">14 public C functions</FONT><BR/><FONT POINT-SIZE="9">k3_open / k3_step / k3_generate /</FONT><BR/><FONT POINT-SIZE="9">k3_save_state / k3_load_state / ...</FONT>>, fillcolor="#e8e0f5"];
        harness -> server [label="  POST /v1/chat/completions  ", fontsize=9];
        server -> libk3  [label="  ctypes  ", fontsize=9];
    }

    // ============================================================
    // ROW 3 — ENGINE FORWARD (per-token)
    // ============================================================
    {
        rank=same;
        f1 [label="k3_tokenize",   fillcolor="#e8e0f5"];
        f2 [label="k3_embed_",     fillcolor="#e8e0f5"];
        f3 [label="k3_layer_ x N\n(69 KDA + 24 MLA)", fillcolor="#e8e0f5"];
        f4 [label="k3_norm_\n+ k3_lm_head", fillcolor="#e8e0f5"];
        f5 [label="k3_argmax_",    fillcolor="#e8e0f5"];
        f6 [label="k3_detokenize", fillcolor="#e8e0f5"];
        f1 -> f2 -> f3 -> f4 -> f5 -> f6 [style=invis];
    }

    // ============================================================
    // ROW 4 — STATE / CACHE (per-request, kept across turns)
    // ============================================================
    {
        rank=same;
        s1 [label="KDA recurrent state\n(~few MB / layer)",            fillcolor="#f5e8e0"];
        s2 [label="MLA KV cache\n(layer-specific)",                     fillcolor="#f5e8e0"];
        s3 [label="LRU expert cache\n(MoE experts, MXFP4)",             fillcolor="#f5e8e0"];
        s4 [label="Trunk cache ring\n(pinned layers)",                  fillcolor="#f5e8e0"];
        s1 -> s2 -> s3 -> s4 [style=invis];
    }

    // ============================================================
    // ROW 5 — MEMORY BOUNDARY
    // ============================================================
    {
        rank=same;
        boundary [label=<<FONT POINT-SIZE="13" COLOR="#ff9a3c"><B>───  memory boundary  ───</B></FONT>>, shape=plaintext, fillcolor="white"];
    }

    // ============================================================
    // ROW 6 — DISK
    // ============================================================
    {
        rank=same;
        trunk       [label=<<FONT POINT-SIZE="11"><B>trunk</B></FONT><BR/><FONT POINT-SIZE="9">108.81 GB (bf16)</FONT><BR/><FONT POINT-SIZE="9">93 layers, packed</FONT>>, fillcolor="#e8e8e8"];
        expert_pool [label=<<FONT POINT-SIZE="11"><B>expert pool</B></FONT><BR/><FONT POINT-SIZE="9">~1.45 TB MXFP4</FONT><BR/><FONT POINT-SIZE="9">92 MoE layers x 896 experts</FONT><BR/><FONT POINT-SIZE="9">= 82,432 experts</FONT><BR/><FONT POINT-SIZE="9">~16.7 MB per expert</FONT>>, fillcolor="#e8e8e8"];
        embed       [label=<<FONT POINT-SIZE="11"><B>embed + lm_head</B></FONT><BR/><FONT POINT-SIZE="9">~4.7 GB bf16</FONT><BR/><FONT POINT-SIZE="9">vocab 163,840</FONT>>, fillcolor="#e8e8e8"];
        trunk -> expert_pool -> embed [style=invis];
    }

    // ============================================================
    // ROW 7 — OFFLINE PREP
    // ============================================================
    {
        rank=same;
        fetch   [label=<<FONT POINT-SIZE="11" COLOR="#5d3fd3"><B>fetch</B></FONT><BR/><FONT POINT-SIZE="9">huggingface-cli</FONT><BR/><FONT POINT-SIZE="9">moonshotai/Kimi-K3-Instruct</FONT><BR/><FONT POINT-SIZE="9">~1.56 TB shards</FONT>>, fillcolor="#c8b8e8"];
        convert [label=<<FONT POINT-SIZE="11" COLOR="#5d3fd3"><B>convert</B></FONT><BR/><FONT POINT-SIZE="9">tools/convert.py</FONT><BR/><FONT POINT-SIZE="9">safetensors to native</FONT><BR/><FONT POINT-SIZE="9">no PyTorch needed</FONT>>, fillcolor="#c8b8e8"];
        fetch -> convert [label="  ~3 hours  ", fontsize=9];
    }

    // ============================================================
    // ROW 8 — LEGEND
    // ============================================================
    {
        rank=same;
        l_eng   [label="engine internals\n(RAM-resident when used)",          fillcolor="#e8e0f5"];
        l_state [label="per-request state",                                   fillcolor="#f5e8e0"];
        l_disk  [label="NVMe (4 KiB-aligned)",                                fillcolor="#e8e8e8"];
        l_prep  [label="offline prep",                                        fillcolor="#c8b8e8"];
        l_principles [label="design principles",                              fillcolor="#e8f5e8"];
        l_eng -> l_state -> l_disk -> l_prep -> l_principles [style=invis];
    }

    // ============================================================
    // VERTICAL EDGES (workflow direction)
    // ============================================================
    boundary -> trunk      [style=invis];
    f3 -> s3              [style=dashed, color="#ff9a3c", label="  streams  ", fontsize=9];
    s4 -> trunk           [style=dashed, color="#ff9a3c", label="  streams  ", fontsize=9];
    f3 -> trunk           [style=dashed, color="#ff9a3c", label="  streams  ", fontsize=9, constraint=false];
    embed -> f2           [style=dashed, color="#888888", arrowhead=none];
    convert -> embed      [style=invis];
}
