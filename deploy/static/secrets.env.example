# secrets.env.example — copy to secrets.env and fill in.
# chmod 600 secrets.env
#
# Get these from the litMoE admin. They live in
# <repo>/deploy/.env on the server (chmod 640).

# OpenAI-style API key (Pi, OpenCode, Qwen, aider, openai SDK).
INTERNAL_API_KEY=replace-me-with-the-key-from-deploy-env

# Claude Code / Anthropic-style API key (often the same key).
ANTHROPIC_API_KEY=replace-me-with-the-key-from-deploy-env

# Server URL. By default uses the LAN host; override if your client
# is going through a tunnel or different hostname.
K3_SERVER=https://YOUR_SERVER_IP