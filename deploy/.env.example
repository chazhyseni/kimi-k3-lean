# Required for the deploy/ stack. Copy to .env and edit.

# Bearer token required by clients hitting /llm/*.
# Generate with:  openssl rand -hex 32
INTERNAL_API_KEY=replace-me-with-a-real-token

# Hostname the Caddy proxy advertises. Used for the TLS cert.
# For LAN pilots: leave as the LAN IP. For public deployments: use the
# public DNS name.
SERVER_NAME=YOUR_SERVER_IP

# TLS mode: "internal" uses Caddy's built-in CA (LAN-safe, browsers
# need cert trust); "dns-cloudflare" or similar for real certs.
TLS_MODE=internal

# CORS — which origins can call /v1/* directly. Empty = no CORS.
# Set this if browsers will call the API via JS.
ALLOWED_ORIGINS=

# Max request body size in bytes. Default 10 MB (10485760).
MAX_REQUEST_BYTES=10485760

# ----- Model backend settings (only used with --profile with-k3) -----
MODEL_API_KEY=                       # defaults to INTERNAL_API_KEY if blank
K3_PRESET=auto                       # laptop | desktop | workstation | server | max | auto
K3_MEMORY_LIMIT=8G                   # limit RAM the k3 container uses

# ----- Optional browser chat UI (--profile with-webui) -----
WEBUI_SECRET_KEY=replace-me
WEBUI_ADMIN_EMAIL=admin@local
WEBUI_ADMIN_PASSWORD=replace-me